APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

# Sin tablas de sesión, caché ni colas: el modelo de datos solo tiene seis tablas
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Token JWT HS256 de 8 horas
JWT_SECRET=
JWT_TTL_SECONDS=28800

# Administrador inicial, lo crea el arranque de la aplicación
ADMIN_USERNAME=
ADMIN_PASSWORD=

COVERS_DIR=./var/covers
CORS_ORIGIN=http://localhost:5173

# Solo para sembrar préstamos vencidos de la demo (spec-review.md, E-02); en uso normal siempre 0
CLOCK_OFFSET_DAYS=0
